FROM python:3.11-slim

WORKDIR /app

# Copy requirements
COPY requirements.txt .

# Install dependencies (plus fastapi tools)
RUN pip install --no-cache-dir -r requirements.txt fastapi uvicorn python-multipart requests

# Copy source
COPY src/ /app/src/
COPY artifacts/ /app/artifacts/
COPY data/cleaned_retail.parquet /app/data/
COPY api.py .

EXPOSE 8000

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
